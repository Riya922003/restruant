NODE_ENV=development

# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restaurantos
POSTGRES_USER=restaurantos
POSTGRES_PASSWORD=restaurantos
DATABASE_URL=postgresql://restaurantos:restaurantos@localhost:5432/restaurantos

# AI service
AI_SERVICE_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Base URL of the FastAPI AI service (no trailing /api; it serves under /ai).
# Baked at build time, so set it before building/deploying the frontend.
NEXT_PUBLIC_AI_URL=http://localhost:8000
