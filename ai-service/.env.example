# RestaurantOS AI Service (FastAPI) environment.
# Copy to .env and fill in. .env is gitignored. Never commit real secrets.

# Same Postgres/Neon instance Express uses. Local Docker or Neon (sslmode=require).
DATABASE_URL=postgresql://restaurantos:restaurantos@localhost:5432/restaurantos

# MUST match Backend's JWT_SECRET so tokens issued by Express verify here.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Allowed CORS origin(s) for the frontend. Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:3000

# Grok / xAI (AI recommendations only, not OCR)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TEXT_MODEL=grok-4

# Veryfi (invoice OCR)
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=

# Redis broker for the RQ invoice queue
REDIS_URL=redis://localhost:6379/0

# Cloudinary (original invoice file storage). Leave empty to use the local
# .uploads/ fallback in development.
CLOUDINARY_URL=

# Uvicorn port for local dev
AI_SERVICE_PORT=8000
