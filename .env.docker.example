# Copy to .env.docker and fill in. Used by:
#   docker compose --env-file .env.docker up --build
#
# The core app (auth, CRUD, dashboard, charts) runs with only the defaults below.
# The AI keys are optional: without them the AI service still boots and degrades
# gracefully (recommendations return a clean error, invoices fall back to a stub
# extractor and local file storage).

# --- Database (compose Postgres; safe defaults) ---
POSTGRES_USER=restaurantos
POSTGRES_PASSWORD=restaurantos
POSTGRES_DB=restaurantos
POSTGRES_PORT=5432

# --- Auth: MUST be identical for backend and ai-service (shared JWT) ---
JWT_SECRET=dev-local-secret-change-me
JWT_EXPIRES_IN=12h
JWT_ALGORITHM=HS256

# --- Origins / public URLs (host-reachable) ---
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- AI providers (optional; leave blank to run without AI) ---
GROK_API_KEY=
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_TEXT_MODEL=llama-3.3-70b-versatile
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=
CLOUDINARY_URL=
REDIS_URL=
